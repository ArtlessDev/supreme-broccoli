    </Variable>
    <Variable Type="PositionUnitType" Name="BoardTitle.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">3</Value>
    </Variable>
    <Variable Type="float" Name="NineSliceInstance.Height" SetsValue="true">
