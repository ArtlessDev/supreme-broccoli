<?xml version="1.0" encoding="utf-8"?>
<ScreenSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>QuestBoard</Name>
  <State>
    <Name>Default</Name>
    <Variable Type="bool" Name="BoardTitle.ExposeChildrenEvents" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable IsFont="true" Type="string" Name="BoardTitle.Font" SetsValue="true">
