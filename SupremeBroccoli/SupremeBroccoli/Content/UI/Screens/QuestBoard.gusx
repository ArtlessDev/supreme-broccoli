    <Variable Type="int" Name="BoardTitle.FontSize" SetsValue="true">
      <Value xsi:type="xsd:int">36</Value>
    </Variable>
    <Variable Type="bool" Name="BoardTitle.HasEvents" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="BoardTitle.HorizontalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="string" Name="BoardTitle.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Quest Board</Value>
    </Variable>
