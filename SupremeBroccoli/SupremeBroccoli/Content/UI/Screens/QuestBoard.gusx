    </Variable>
    <Variable Type="DimensionUnitType" Name="NineSliceInstance.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="bool" Name="NineSliceInstance.IsTilingMiddleSections" SetsValue="true">
