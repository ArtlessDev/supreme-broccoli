    </Variable>
    <Variable Type="PositionUnitType" Name="BoardTitle.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="float" Name="BoardTitle.Y" SetsValue="true">
