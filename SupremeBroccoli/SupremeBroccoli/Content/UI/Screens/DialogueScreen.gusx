<?xml version="1.0" encoding="utf-8"?>
<ScreenSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>DialogueScreen</Name>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="DialogueBox.Height" SetsValue="true">
      <Value xsi:type="xsd:float">25</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="DialogueBox.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="float" Name="DialogueBox.Width" SetsValue="true">
      <Value xsi:type="xsd:float">80</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="DialogueBox.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="float" Name="DialogueBox.X" SetsValue="true">
      <Value xsi:type="xsd:float">50</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="DialogueBox.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="DialogueBox.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="float" Name="DialogueBox.Y" SetsValue="true">
      <Value xsi:type="xsd:float">95</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="DialogueBox.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="DialogueBox.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">3</Value>
    </Variable>
  </State>
  <Instance Name="DialogueBox" BaseType="Controls/DialogBox" />
  <Behaviors />
</ScreenSave>